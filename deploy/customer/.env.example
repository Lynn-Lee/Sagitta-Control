# SagittaDB Enterprise customer deployment environment.
# Copy this file to .env and replace every CHANGE_ME value before starting.

POSTGRES_DB=sagittadb
POSTGRES_USER=sagitta
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Production requires a stable 32+ character secret.
# Do not change SECRET_KEY after data has been encrypted.
SECRET_KEY=CHANGE_ME_RANDOM_32_PLUS_CHARS

# SagittaDB Enterprise license verification.
LICENSE_PUBLIC_KEY=
LICENSE_CUSTOMER_ID=
LICENSE_SERVER_URL=
LICENSE_SERVER_TOKEN=
LICENSE_AUTO_REFRESH_ENABLED=true
LICENSE_RENEWAL_NOTIFY_DAYS=30,7
LICENSE_TRIAL_DAYS=30

APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

BACKEND_PORT=8000
FRONTEND_PORT=80
CELERY_CONCURRENCY=8

PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
GRAFANA_URL=http://localhost:3000

ENABLE_GOINCEPTION=false
GO_INCEPTION_HOST=goinception:4000

ORACLE_DRIVER_MODE=auto
ORACLE_CLIENT_LIB_DIR=
ORACLE_CLIENT_CONFIG_DIR=
