{
  "name": "sagittadb-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:check": "npm run build && node scripts/check-build-budget.mjs",
    "preview": "vite preview",
    "e2e:smoke": "E2E_SMOKE_ONLY=true node scripts/capture-user-manual-screenshots.mjs",
    "screenshots:user-manual": "node scripts/capture-user-manual-screenshots.mjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.28.0",
    "@tanstack/react-query-devtools": "^5.28.0",
    "antd": "^5.15.0",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dompurify": "^3.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^25.0.1",
    "terser": "^5.47.1",
    "typescript": "^5.3.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "dompurify": "^3.4.2"
  }
}
