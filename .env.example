# ─── 数据库 ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sagitta:sagitta123@postgres:5432/sagitta_control
# 同步 URL，仅供 Alembic migration 使用
DATABASE_URL_SYNC=postgresql+psycopg2://sagitta:sagitta123@postgres:5432/sagitta_control

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:redis123@redis:6379/0

# ─── 安全 ─────────────────────────────────────────────────────
# 生产环境请替换为随机 32+ 字符字符串；启动时会拒绝默认值、短值和常见弱模式
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_32_CHARS
# 字段级加密专用 Fernet 密钥；生产环境必须与 SECRET_KEY 分离并长期保持稳定
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_GENERATE_WITH_cryptography_fernet
# JWT 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7
# 浏览器登录态 Cookie 是否仅允许 HTTPS 发送；公网 HTTPS 生产环境必须设为 true，HTTP 源码测试环境可保留 false
AUTH_COOKIE_SECURE=false
# 仅供 HTTP 源码测试环境临时开启；公网或客户生产环境必须保持 false
ALLOW_INSECURE_AUTH_COOKIE=false
# Cookie SameSite 策略，默认 strict；跨站统一登录等场景需评估后调整
AUTH_COOKIE_SAMESITE=strict
# 如需限制 Cookie 域名可配置，例如 .example.com；默认空值表示当前域
AUTH_COOKIE_DOMAIN=
# 应用前置的可信反向代理层数，用于从 X-Forwarded-For 还原真实客户端 IP 写入审计与查询日志
# 标准部署为单层 nginx，保持 1；无反向代理直连时设为 0（忽略 XFF，仅信任 socket 对端地址）
# 多层代理（如 CDN + nginx）按实际层数设置；该机制需配合 backend 仅内网可达以防 XFF 伪造
TRUSTED_PROXY_COUNT=1

# ─── 商业授权 ─────────────────────────────────────────────────
# Ed25519 公钥，默认使用官方 License-Server-Center 验签公钥；私钥只用于内部签发工具，绝不进入客户环境。
LICENSE_PUBLIC_KEY=3Jz3SK-mTWZwGy6VX8gUBUWJ-kisvGnO3c_x18Fk_Ms
# 可选：绑定客户 ID；为空时仅校验签名和有效期。
LICENSE_CUSTOMER_ID=
# 在线激活/续期服务器，源码部署和商业部署默认使用官方授权中心。
LICENSE_SERVER_URL=https://license.loveai.asia
# 可选：授权服务器 Bearer Token；仅在线激活/续期需要。
LICENSE_SERVER_TOKEN=
LICENSE_AUTO_REFRESH_ENABLED=true
LICENSE_RENEWAL_NOTIFY_DAYS=30,7
LICENSE_TRIAL_DAYS=60
# 可选但推荐：稳定部署 ID，用于生成 License 部署指纹；生产环境生成后不要更改。
LICENSE_DEPLOYMENT_ID=

# ─── 多租户（SaaS 预留，企业版固定为 1）────────────────────────
TENANT_ID=1

# ─── 可观测中心 ────────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
GRAFANA_URL=http://localhost:3000
# 如启用 Grafana OAuth，对应 deploy/docker-compose.yml 的 GRAFANA_CLIENT_SECRET 必须替换为非默认随机值
GRAFANA_CLIENT_SECRET=CHANGE_ME_RANDOM_GRAFANA_OAUTH_SECRET

# ─── goInception（可选增强，用于 MySQL SQL 审核）────────────────
ENABLE_GOINCEPTION=false
GO_INCEPTION_HOST=goinception:4000

# ─── Oracle（11g 需 Thick 模式 + Instant Client）────────────────
# auto: 优先尝试 Thick，失败后回退 Thin
# thin: 强制 Thin（仅 Oracle 12.1+）
# thick: 强制 Thick（Oracle 11.2 推荐；未安装 Instant Client 会直接报错）
ORACLE_DRIVER_MODE=auto
# Linux 容器通常留空，并通过 ldconfig / LD_LIBRARY_PATH 暴露库路径；
# macOS / Windows 本地运行时可显式指定 Instant Client 目录
ORACLE_CLIENT_LIB_DIR=
# 可选：tnsnames.ora / sqlnet.ora 所在目录
ORACLE_CLIENT_CONFIG_DIR=

# ─── 认证扩展（通过系统配置页面管理，非环境变量）──────────────
# 以下配置已废弃，认证（LDAP/CAS/钉钉/飞书/企微）统一通过
# /api/v1/system/config 接口管理（运行时可修改，无需重启服务）
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldap://ldap:389
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_DN_TEMPLATE=uid=%(user)s,ou=users,dc=example,dc=com

# ─── AI 能力（通过系统配置页面管理）──────────────────────────
# AI_API_KEY=sk-ant-...  # 在系统配置 → AI 功能 中设置

# ─── 通知（通过系统配置页面管理）──────────────────────────────
# 钉钉/飞书/企微 Webhook、邮件 SMTP 等统一在 /api/v1/system/config 中配置

# ─── PostgreSQL（Docker Compose 用）──────────────────────────
POSTGRES_DB=sagitta_control
POSTGRES_USER=sagitta
POSTGRES_PASSWORD=sagitta123

# ─── 应用环境 ─────────────────────────────────────────────────
# development / production
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
